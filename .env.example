# Configure sources directly in src/App.vue. Keep private subscription URLs out of git.
# Used only by `pnpm photos:sync`; it may be a local directory or rsync remote.
PHOTO_SYNC_SOURCE=user@photo-host:/path/to/curated-photos/
# Used by the Wikimedia daily featured-content API. Replace with a contactable app identifier.
WIKIMEDIA_USER_AGENT=PiKiosk/1.0 (your-email@example.com)
# Optional contactable identifier for the National Weather Service alerts API.
NWS_USER_AGENT=PiKiosk/1.0 (your-email@example.com)
